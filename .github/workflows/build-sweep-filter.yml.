name: Build Sweep Filter

# One-file setup: this workflow writes the whole Sweep Filter project into
# plugins/Sweep Filter/ on the build server, then builds and validates it.
# To change the plugin later, edit the file contents below.

on:
  push:
  workflow_dispatch:   # lets you press "Run workflow" from the Actions tab

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Write plugin files
        run: |
          set -e
          mkdir -p "plugins/Sweep Filter"
          cd "plugins/Sweep Filter"
          mkdir -p "$(dirname "plugin.json")"
          cat > "plugin.json" <<'SWEEPEOF'
          {
            "name": "Sweep Filter",
            "manufacturer": "gltchsqnz",
            "version": "1.0.0",
            "format": "vst2",
            "kind": "effect",
            "uid": "GZsr",
            "numInputs": 2,
            "numOutputs": 2,
            "category": "Effect",
            "shortName": "Sweep Filter",
            "knobs": [
              {
                "parameter": 2,
                "label": "Cutoff"
              },
              {
                "parameter": 4,
                "label": "Depth"
              },
              {
                "parameter": 5,
                "label": "Rate"
              }
            ],
            "shiftKnobs": [
              {
                "parameter": 3,
                "label": "Reso"
              },
              {
                "parameter": 8,
                "label": "Mix"
              },
              {
                "parameter": 6,
                "label": "Shape"
              }
            ],
            "file32": "VST/sweep-filter-arm32.so",
            "file64": "VST/sweep-filter-arm64.so",
            "description": "Tempo-synced auto filter. An LFO sweeps an LP/BP/HP/Notch filter, locked to the song position with cycles from 1/16 note up to 64 bars.",
            "author": "gltchsqnz",
            "url": "",
            "license": "MIT"
          }
          SWEEPEOF
          mkdir -p "$(dirname "ui.json")"
          cat > "ui.json" <<'SWEEPEOF'
          {
            "kit": "cyan",
            "qlinkGroups": "rows",
            "pages": [
              {
                "name": "SWEEP",
                "controls": [
                  {
                    "param": "Rate",
                    "widget": "knob",
                    "overlay": "menu"
                  },
                  {
                    "param": "Depth",
                    "widget": "knob"
                  },
                  {
                    "param": "Shape",
                    "widget": "knob",
                    "overlay": "menu"
                  },
                  {
                    "param": "Phase",
                    "widget": "knob"
                  },
                  {
                    "param": "Cutoff",
                    "widget": "knob"
                  },
                  {
                    "param": "Reso",
                    "widget": "knob"
                  },
                  {
                    "param": "Mode",
                    "widget": "switch"
                  },
                  "empty",
                  {
                    "param": "Mix",
                    "widget": "fader"
                  },
                  {
                    "param": "Level",
                    "widget": "fader"
                  },
                  "empty",
                  "empty"
                ]
              }
            ]
          }
          SWEEPEOF
          mkdir -p "$(dirname "README.md")"
          cat > "README.md" <<'SWEEPEOF'
          # Sweep Filter

          A tempo-synced auto filter for Akai MPC standalone, by gltchsqnz.

          An LFO sweeps the cutoff of a stereo state-variable filter. The LFO cycle can be
          anything from a 1/16 note up to **64 bars**, and while the MPC is playing it is
          locked to the song position, so long sweeps stay in time across loops, jumps and
          mid-song starts.

          ## Parameters

          | # | Name | What it does |
          |---|------|--------------|
          | 0 | Level | Output volume, -24 to +12 dB |
          | 1 | Mode | LP / BP / HP / Notch |
          | 2 | Cutoff | Centre frequency of the sweep, 40 Hz to 16 kHz |
          | 3 | Reso | Resonance, 0 to 100 % |
          | 4 | Depth | Sweep width; 100 % = +/- 4 octaves around Cutoff |
          | 5 | Rate | Cycle length: 1/16, 1/8, 1/4, 1/2, 1, 2, 4, 8, 16, 32, 64 bars |
          | 6 | Shape | Sine, Triangle, Saw Up, Saw Down, Square |
          | 7 | Phase | Shifts the sweep within its cycle |
          | 8 | Mix | Dry/wet |

          Programs: Epic Rise (64 bars), Slow Rise (32), Long Sweep (16), Wobble (1/8),
          Bar Gate (1 bar, band-pass square), Phaser Ish (4 bars, notch, 60 % mix).

          ## Sync behaviour

          - **Playing:** LFO phase = song position / cycle length. Bars follow the project's
            time signature (a bar in 3/4 is 3 beats, so 64 bars = 192 beats).
          - **Stopped:** the LFO free-runs at the project tempo, continuing from where
            playback left off.
          - The cycle restarts at the song start and every cycle length after it. Use
            **Phase** to move the sweep's start point.

          ## Notes

          - Saw Up with a long Rate is a filter riser; Saw Down is a long fade-out of the sweep.
          - Square makes hard steps, softened by a few ms of smoothing to avoid clicks.
          - The BP mode is quieter than LP/HP at low resonance; raise Reso or Level.
          - CPU is very low: coefficients update every 16 samples, per-sample work is one SVF per channel.

          ## Knob FX mapping

          The SDK requires effects to declare one. It only matters on an MPC Sample:
          knobs Cutoff / Depth / Rate; SHIFT + knobs Reso / Mix / Shape.

          ## Licence

          MIT. Built on the MPC Plugin SDK's `dsp/svf.h` (Cytomic/Simper topology) and `dsp/tempo.h`.
          SWEEPEOF
          mkdir -p "$(dirname "src/SweepFilter.cpp")"
          cat > "src/SweepFilter.cpp" <<'SWEEPEOF'
          // Sweep Filter - an MPC insert effect plugin by gltchsqnz
          //
          // A tempo-synced auto filter. An LFO sweeps the cutoff of a stereo state-variable
          // filter. The LFO cycle can be anything from 1/16 note up to 64 bars.
          //
          // Signal flow:
          //     in -> SVF (LP / BP / HP / Notch) -> dry/wet Mix -> Level -> out
          //                 ^
          //                 | cutoff = Cutoff * 2^(LFO * Depth * 4)      (sweep in octaves)
          //
          // Sync:
          //   * While the MPC is PLAYING, the LFO phase is computed straight from the song
          //     position (ppq), so it is locked to the bars of the project: loops, jumps and
          //     starting playback mid-song all land on the right point of a 32/64 bar sweep.
          //   * While STOPPED, the LFO free-runs at the project tempo, so you still hear it.
          //   * Bar lengths follow the project's time signature.
          //
          // Parameters (order is permanent once released; append new ones at the END):
          //   0 Level      output volume (dB)  - harmless on load, as the host nudges param 0
          //   1 Mode       LP / BP / HP / Notch
          //   2 Cutoff     centre frequency of the sweep (Hz)
          //   3 Reso       filter resonance (%)
          //   4 Depth      sweep width, 100% = +/- 4 octaves
          //   5 Rate       LFO cycle length: 1/16 .. 1/2 note, then 1 .. 64 bars
          //   6 Shape      Sine / Triangle / Saw Up / Saw Down / Square
          //   7 Phase      shifts the sweep within its cycle (%)
          //   8 Mix        dry/wet (%)
          //
          // CPU: the filter coefficients (one tan()) and LFO are updated every kCtrl samples;
          // per sample there is only the SVF arithmetic and the smoothers.

          #include "mpc_plugin.h"
          #include "dsp/math.h"
          #include "dsp/svf.h"
          #include "dsp/tempo.h"

          #include <algorithm>
          #include <cmath>

          using namespace mpc::dsp;

          namespace {

          enum ParamIndex
          {
              kLevel = 0,  // dB
              kMode,       // choice
              kCutoff,     // Hz
              kReso,       // %
              kDepth,      // %
              kRate,       // choice (see kRates)
              kShape,      // choice
              kPhase,      // %
              kMix,        // % wet
              kNumParams
          };

          constexpr int kMaxChannels = 2;
          constexpr int kCtrl        = 16;     // control-rate block (samples)
          constexpr float kSweepOctaves = 4.0f; // Depth 100% = +/- this many octaves
          constexpr double kTwoPi    = 6.283185307179586;

          // LFO cycle lengths. Sub-bar lengths are in beats (quarter notes); the rest are in
          // bars, converted with the project's time signature.
          struct RateDef { const char* name; float beats; float bars; };
          const RateDef kRates[] = {
              {"1/16",     0.25f, 0.0f}, {"1/8",      0.5f, 0.0f}, {"1/4",  1.0f, 0.0f}, {"1/2", 2.0f, 0.0f},
              {"1 bar",    0.0f,  1.0f}, {"2 bars",   0.0f, 2.0f}, {"4 bars",  0.0f, 4.0f},
              {"8 bars",   0.0f,  8.0f}, {"16 bars",  0.0f, 16.0f}, {"32 bars", 0.0f, 32.0f}, {"64 bars", 0.0f, 64.0f}
          };
          constexpr int kNumRates = (int)(sizeof(kRates) / sizeof(kRates[0]));
          constexpr int kDefaultRate = 6;      // 4 bars

          enum Shape { kSine = 0, kTri, kSawUp, kSawDown, kSquare, kNumShapes };

          // One-pole smoother, advanced once per control block.
          struct Smooth
          {
              float v = 0.0f, rate = 0.1f;
              void  snap(float x) { v = x; }
              float next(float target) { v += rate * (target - v); return v; }
          };

          // Per-sample smoother for gain-type controls (avoids zipper noise).
          struct SampleSmooth
          {
              float v = 0.0f, rate = 0.002f;
              void  snap(float x) { v = x; }
              float next(float target) { v += rate * (target - v); return v; }
          };

          // LFO shape, phase 0..1 -> -1..+1 (all start at 0 or at an extreme, see comments).
          inline float lfoShape(int shape, float ph)
          {
              switch (shape)
              {
                  case kSine:    return std::sin((float)kTwoPi * ph);
                  case kTri:     return ph < 0.25f ? 4.0f * ph : (ph < 0.75f ? 2.0f - 4.0f * ph : 4.0f * ph - 4.0f);
                  case kSawUp:   return 2.0f * ph - 1.0f;
                  case kSawDown: return 1.0f - 2.0f * ph;
                  case kSquare:  return ph < 0.5f ? 1.0f : -1.0f;
                  default:       return 0.0f;
              }
          }

          } // namespace

          class SweepFilter : public mpc::Plugin
          {
          public:
              SweepFilter() : mpc::Plugin(makeInfo())
              {
                  using namespace mpc;

                  std::vector<std::string> rateNames;
                  for (int i = 0; i < kNumRates; ++i) rateNames.push_back(kRates[i].name);

                  // ids are saved in projects: never rename them once released.
                  addParam(floatParam ("level",  "Level",  -24.0f, 12.0f, 0.0f,    "dB", 1));
                  addParam(choiceParam("mode",   "Mode",   {"LP", "BP", "HP", "Notch"}, 0));
                  addParam(logParam   ("cutoff", "Cutoff", 40.0f, 16000.0f, 800.0f, "Hz", 0));
                  addParam(floatParam ("reso",   "Reso",   0.0f, 100.0f, 30.0f,    "%",  0));
                  addParam(floatParam ("depth",  "Depth",  0.0f, 100.0f, 60.0f,    "%",  0));
                  addParam(choiceParam("rate",   "Rate",   rateNames, kDefaultRate));
                  addParam(choiceParam("shape",  "Shape",  {"Sine", "Triangle", "Saw Up", "Saw Down", "Square"}, 0));
                  addParam(floatParam ("phase",  "Phase",  0.0f, 100.0f, 0.0f,     "%",  0));
                  addParam(floatParam ("mix",    "Mix",    0.0f, 100.0f, 100.0f,   "%",  0));

                  // Built-in programs, plain values in parameter order:
                  //        Level Mode Cutoff Reso Depth Rate Shape Phase Mix
                  addProgram("Epic Rise",  {0.0f, 0, 500.0f,  45.0f, 75.0f, 10, kSawUp,   0.0f, 100.0f});  // 64 bars
                  addProgram("Slow Rise",  {0.0f, 0, 600.0f,  40.0f, 70.0f, 9,  kSawUp,   0.0f, 100.0f});  // 32 bars
                  addProgram("Long Sweep", {0.0f, 0, 800.0f,  30.0f, 60.0f, 8,  kSine,    0.0f, 100.0f});  // 16 bars
                  addProgram("Wobble",     {0.0f, 0, 500.0f,  60.0f, 55.0f, 1,  kTri,     0.0f, 100.0f});  // 1/8
                  addProgram("Bar Gate",   {0.0f, 1, 1200.0f, 70.0f, 80.0f, 4,  kSquare,  0.0f, 100.0f});  // 1 bar
                  addProgram("Phaser Ish", {0.0f, 3, 1500.0f, 50.0f, 40.0f, 6,  kSine,    0.0f, 60.0f});   // 4 bars
              }

              void prepare(double sampleRate, int maxBlockSize) override
              {
                  (void)maxBlockSize;
                  sampleRate_ = (float)sampleRate;
                  for (int ch = 0; ch < kMaxChannels; ++ch) filters_[ch].setSampleRate(sampleRate);
                  reset();
              }

              void reset() override
              {
                  for (int ch = 0; ch < kMaxChannels; ++ch) filters_[ch].reset();
                  level_.snap(dbToGain(get(kLevel)));
                  mix_.snap(get(kMix) * 0.01f);
                  cutoff_.snap(get(kCutoff));
                  reso_.snap(get(kReso) * 0.01f);
                  depth_.snap(get(kDepth) * 0.01f);
                  mod_ = 0.0f;
                  freePhase_ = 0.0;
              }

              void process(mpc::ProcessContext& ctx) override
              {
                  const int numFrames   = ctx.numFrames;
                  const int numChannels = mpc::clamp(ctx.numOutputs, 0, kMaxChannels);
                  const mpc::Transport& t = ctx.transport;

                  // --- read parameters once per block ---------------------------------
                  const int   mode        = getInt(kMode);
                  const int   shape       = mpc::clamp(getInt(kShape), 0, (int)kNumShapes - 1);
                  const float phaseOffset = get(kPhase) * 0.01f;
                  const float cutoffT     = get(kCutoff);
                  const float resoT       = get(kReso) * 0.01f;
                  const float depthT      = get(kDepth) * 0.01f;
                  const float levelT      = dbToGain(get(kLevel));
                  const float mixT        = get(kMix) * 0.01f;

                  // --- LFO cycle length in beats --------------------------------------
                  const RateDef& r = kRates[mpc::clamp(getInt(kRate), 0, kNumRates - 1)];
                  const double beatsPerBar = (t.timeSigNumerator > 0 && t.timeSigDenominator > 0)
                                                 ? 4.0 * (double)t.timeSigNumerator / (double)t.timeSigDenominator
                                                 : 4.0;
                  const double cycleBeats = r.bars > 0.0f ? (double)r.bars * beatsPerBar : (double)r.beats;

                  const bool   locked       = t.playing && t.ppqValid;
                  const double ppqPerSample = (double)safeBpm(t.bpm) / 60.0 / (double)sampleRate_;

                  for (int start = 0; start < numFrames; start += kCtrl)
                  {
                      const int len = std::min(kCtrl, numFrames - start);

                      // LFO phase: locked to song position while playing, free-running otherwise.
                      double ph;
                      if (locked)
                      {
                          // Double precision matters here: 64 bars = 256 beats of song position.
                          const double cycles = (t.ppqPos + (double)start * ppqPerSample) / cycleBeats;
                          ph = cycles - std::floor(cycles);
                          freePhase_ = ph;                       // so stopping continues smoothly
                      }
                      else
                      {
                          ph = freePhase_;
                          freePhase_ += (double)len * ppqPerSample / cycleBeats;
                          freePhase_ -= std::floor(freePhase_);
                      }

                      double pho = ph + (double)phaseOffset;
                      pho -= std::floor(pho);

                      // Smooth the LFO (kills the hard edges of square/saw) and the controls.
                      mod_ += 0.15f * (lfoShape(shape, (float)pho) - mod_);
                      const float cutoff = cutoff_.next(cutoffT);
                      const float reso   = reso_.next(resoT);
                      const float depth  = depth_.next(depthT);

                      const float freq = cutoff * std::exp2(mod_ * depth * kSweepOctaves);
                      for (int ch = 0; ch < numChannels; ++ch) filters_[ch].set(freq, reso);

                      for (int n = 0; n < len; ++n)
                      {
                          const int i = start + n;
                          const float level = level_.next(levelT);
                          const float mix   = mix_.next(mixT);

                          for (int ch = 0; ch < numChannels; ++ch)
                          {
                              const float dry = (ctx.inputs != nullptr && ch < ctx.numInputs && ctx.inputs[ch] != nullptr)
                                                    ? ctx.inputs[ch][i] : 0.0f;
                              const float wet = filters_[ch].process(dry, mode);
                              ctx.outputs[ch][i] = (dry + (wet - dry) * mix) * level;
                          }
                      }
                  }
              }

              void parameterChanged(int index, float plainValue) override { (void)index; (void)plainValue; }

          private:
              static mpc::PluginInfo makeInfo()
              {
                  mpc::PluginInfo info;
                  info.name         = "Sweep Filter";
                  info.vendor       = "gltchsqnz";   // must match plugin.json "manufacturer"
                  info.uniqueId     = MPC_FOURCC(kUid[0], kUid[1], kUid[2], kUid[3]);   // must match plugin.json "uid"
                  info.version      = 1000;           // 1.0.0.0
                  info.isInstrument = false;
                  info.numInputs    = 2;
                  info.numOutputs   = 2;
                  info.tailSamples  = 1;              // no tail
                  return info;
              }

              static constexpr char kUid[5] = "GZsr";

              static float dbToGain(float dB) { return std::pow(10.0f, dB / 20.0f); }

              SVF          filters_[kMaxChannels];
              SampleSmooth level_, mix_;
              Smooth       cutoff_, reso_, depth_;
              float        mod_        = 0.0f;
              double       freePhase_  = 0.0;
              float        sampleRate_ = 44100.0f;
          };

          MPC_PLUGIN_ENTRY(SweepFilter)
          SWEEPEOF
      - name: Build, validate, make MPC folder
        run: python tools/build.py "plugins/Sweep Filter"
      - name: Upload MPC plugin folder
        uses: actions/upload-artifact@v4
        with:
          name: Sweep-Filter-MPC
          path: plugins/Sweep Filter/build/*VST*
          if-no-files-found: error
